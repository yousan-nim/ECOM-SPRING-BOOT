# ─────────────────────────────────────────────────────────────
# ECOM API — environment template
# Copy to .env.local / .env.dev / .env.prod and edit values.
# ─────────────────────────────────────────────────────────────

# Spring
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Database
POSTGRES_DB=ecom
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom

# JDBC (used by Spring inside containers — uses service name `postgres`)
DB_URL=jdbc:postgresql://postgres:5432/ecom
DB_USERNAME=ecom
DB_PASSWORD=ecom
DB_POOL_MAX=20
DB_POOL_MIN=5

# pgAdmin
PGADMIN_EMAIL=admin@ecom.dev
PGADMIN_PASSWORD=admin

# Swagger
SWAGGER_ENABLED=true

# Docker image
API_IMAGE=ecom-api
API_TAG=local
API_REPLICAS=1

# JVM
JAVA_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0
